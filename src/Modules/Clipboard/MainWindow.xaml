<Window x:Class="ClipboardApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="클립보드" Width="380" Height="520"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Margin="0,1" Padding="6" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3E" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F5FA8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#202022" BorderBrush="#4A4A4E" BorderThickness="1" CornerRadius="10" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5" />
        </Border.Effect>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox" Grid.Row="0" Margin="0,0,0,8" Padding="6,4"
                     Background="#2B2B2E" Foreground="White" BorderBrush="#4A4A4E" CaretBrush="White"
                     TextChanged="SearchBox_TextChanged" />

            <ListBox x:Name="List" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="60000"
                              ToolTipService.BetweenShowDelay="0">
                            <!-- [ToolHub] 마우스 오버 시 전체 내용 표시 -->
                            <Grid.ToolTip>
                                <ToolTip Background="#2B2B2E" BorderBrush="#4A4A4E" Foreground="White"
                                         Padding="10" MaxWidth="580">
                                    <StackPanel>
                                        <Image Source="{Binding Preview}" MaxWidth="520" MaxHeight="340"
                                               Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,8"
                                               Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding FullText}" TextWrapping="Wrap" MaxHeight="440"
                                                   TextTrimming="None" />
                                    </StackPanel>
                                </ToolTip>
                            </Grid.ToolTip>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#6CB6FF"
                                       Text="{Binding Number}" />

                            <Border Grid.Column="1" Width="72" Height="54" Margin="0,0,8,0" CornerRadius="4"
                                    Background="#111113" ClipToBounds="True"
                                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Foreground="White" TextWrapping="Wrap"
                                           MaxHeight="54" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Foreground="#A0A0A8" FontSize="11"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Column="3" Content="✕" Click="Delete_Click" Width="22" Height="22"
                                    VerticalAlignment="Top" Background="Transparent" Foreground="#A0A0A8"
                                    BorderThickness="0" Cursor="Hand" ToolTip="삭제" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="2" Margin="2,8,2,0" Foreground="#80808A" FontSize="11"
                       Text="Ctrl+1~0 바로 붙여넣기 · ↑↓ 이동 · Enter 붙여넣기 · Del 삭제 · Esc 닫기" />
        </Grid>
    </Border>
</Window>
