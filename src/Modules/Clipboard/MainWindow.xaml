<Window x:Class="ClipboardApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="클립보드" Width="380" Height="520"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Margin="0" Padding="6,2" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5" />
        </Border.Effect>
        <Grid Margin="8">

          <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox" Padding="6,4"
                     Background="{DynamicResource BoxBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" CaretBrush="{DynamicResource TextBrush}"
                     TextChanged="SearchBox_TextChanged" />
            <TextBlock x:Name="SearchHint" Text="/ 를 누르거나 클릭해서 검색" IsHitTestVisible="False"
                       Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>

            <ListBox x:Name="List" Grid.Row="1" FocusVisualStyle="{x:Null}" Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch" SelectionChanged="List_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                     PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp">
                <!-- [ToolHub] 항목 확장: 한 열 10개(행 높이 고정), 열이 오른쪽으로 이어진다 -->
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Vertical" Height="{DynamicResource PanelH}"
                                   ItemHeight="{DynamicResource RowH}" ItemWidth="{DynamicResource ColW}" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="Transparent" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="60000"
                              ToolTipService.BetweenShowDelay="0">
                            <!-- [ToolHub] 마우스 오버 시 전체 내용 표시 -->
                            <Grid.ToolTip>
                                <ToolTip Background="{DynamicResource BoxBrush}" BorderBrush="{DynamicResource LineBrush}" Foreground="{DynamicResource TextBrush}"
                                         Padding="10" MaxWidth="580">
                                    <StackPanel>
                                        <Image Source="{Binding Preview}" MaxWidth="520" MaxHeight="340"
                                               Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,8"
                                               Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding FullText}" TextWrapping="Wrap" MaxHeight="440"
                                                   TextTrimming="None" />
                                    </StackPanel>
                                </ToolTip>
                            </Grid.ToolTip>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding Number}" />

                            <Border Grid.Column="1" Width="38" Height="28" Margin="0,0,8,0" CornerRadius="4"
                                    Background="{DynamicResource ThumbBrush}" ClipToBounds="True"
                                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock FontSize="12" Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                                <Grid Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Subtitle}" Foreground="{DynamicResource SubBrush}" FontSize="10"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Foreground="{DynamicResource DimBrush}" FontSize="10"
                                               Margin="6,0,0,0" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- [ToolHub] 페이지 표시: 접힘=세로 점(오른쪽), 펼침=가로 점(하단) -->
            <StackPanel x:Name="VDots" Grid.Row="1" Grid.Column="1" Width="16" VerticalAlignment="Center" />
            <StackPanel x:Name="HDots" Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Height="14" Margin="0,6,0,0" Visibility="Hidden" />

            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="2,8,2,0" Foreground="{DynamicResource DimBrush}" FontSize="11"
                       Text="1~0 붙여넣기 · / 검색 · ↑↓←→ PgUp/PgDn 이동 · Enter 붙여넣기 · Tab 항목 펼치기 · Del 삭제 · Esc 닫기"
                       TextWrapping="Wrap" />
          </Grid>

        </Grid>
    </Border>
</Window>
